# Copy to backend/.env (or export these) — settings.py reads them at startup.
# Everything here has a safe development default, so the app still runs unset.

# Required as soon as DJANGO_DEBUG is off.
DJANGO_SECRET_KEY=

# "true" for local development, "false" in production.
DJANGO_DEBUG=true

# Comma-separated. Defaults to "*" in debug, "localhost,127.0.0.1" otherwise.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from a browser.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database — SQLite by default. For MySQL:
#   DB_ENGINE=django.db.backends.mysql
DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=lets_learn_together
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
